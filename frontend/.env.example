# Backend API base URL.
# Development: leave empty (Vite proxy forwards /api/* to localhost:8000)
# Production:  set to the deployed backend origin
VITE_API_BASE_URL=

# Vite dev-server proxy target (Node env, not exposed to the browser).
# Only needed if your local Django runs on a non-standard port or host.
API_PROXY_TARGET=http://localhost:8000
